{
  "name": "exception-lens",
  "displayName": "Exception Lens",
  "description": "Map exception propagation through TypeScript Express applications and find gaps in error middleware.",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "publisher": "johnjosephtopacio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnJosephTopacio/exception-lens.git"
  },
  "homepage": "https://github.com/JohnJosephTopacio/exception-lens#readme",
  "bugs": {
    "url": "https://github.com/JohnJosephTopacio/exception-lens/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Linters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "exceptions",
    "error handling",
    "express",
    "typescript",
    "static analysis"
  ],
  "activationEvents": [
    "onCommand:exceptionLens.scan",
    "onView:exceptionLens.routes",
    "workspaceContains:**/*.ts"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "exceptionLens.scan",
        "title": "Exception Lens: Analyze Workspace",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "exceptionLens.showGraph",
        "title": "Exception Lens: Show Exception Map"
      },
      {
        "command": "exceptionLens.exportReport",
        "title": "Exception Lens: Export Coverage Report",
        "icon": "$(export)"
      },
      {
        "command": "exceptionLens.createHandlerDraft",
        "title": "Exception Lens: Draft Middleware Handler"
      },
      {
        "command": "exceptionLens.openLocation",
        "title": "Exception Lens: Open Source"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "exceptionLens",
          "title": "Exception Lens",
          "icon": "media/lens.svg"
        }
      ]
    },
    "views": {
      "exceptionLens": [
        {
          "id": "exceptionLens.summary",
          "name": "Boundary Coverage"
        },
        {
          "id": "exceptionLens.routes",
          "name": "Routes & Exceptions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "exceptionLens.routes",
        "contents": "Trace failures from Express routes to your error middleware.\n[Analyze workspace](command:exceptionLens.scan)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "exceptionLens.scan",
          "when": "view == exceptionLens.routes || view == exceptionLens.summary",
          "group": "navigation@1"
        },
        {
          "command": "exceptionLens.exportReport",
          "when": "view == exceptionLens.routes",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "exceptionLens.showGraph",
          "when": "view == exceptionLens.routes && viewItem == route",
          "group": "inline@1"
        },
        {
          "command": "exceptionLens.createHandlerDraft",
          "when": "view == exceptionLens.routes && viewItem == unmappedException",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "Exception Lens",
      "properties": {
        "exceptionLens.include": {
          "type": "array",
          "default": [
            "**/*.ts",
            "**/*.tsx"
          ],
          "description": "Glob patterns considered during analysis."
        },
        "exceptionLens.exclude": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            "**/*.d.ts"
          ],
          "description": "Glob patterns ignored during analysis."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild ./src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "package": "pnpm run check && pnpm run test && pnpm run build",
    "package:vsix": "pnpm run package && pnpm exec vsce package --no-dependencies"
  },
  "dependencies": {
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2"
  }
}
